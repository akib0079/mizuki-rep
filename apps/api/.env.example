# Mizuki booking API — copy to .env and fill in.
# On Hostinger these go into the Node.js app's environment variables panel, not a file.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# MongoDB Atlas. Hostinger's Node panel has a connect wizard for this.
# The user needs readWrite on the database, and Atlas Network Access must allow the app's IP.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mizuki?retryWrites=true&w=majority

# --- Secrets ----------------------------------------------------------------
# Generate each with:  openssl rand -base64 48
JWT_SECRET=
CRON_SECRET=
# Must match the "Shared secret" field in the WordPress plugin's settings.
WOO_WEBHOOK_SECRET=

# --- Addresses --------------------------------------------------------------
PUBLIC_API_URL=https://api.mizuki.com.sg
PUBLIC_SITE_URL=https://mizuki.com.sg
# Browser origins allowed to call the API. Leave blank to allow any (development only).
CORS_ORIGINS=https://mizuki.com.sg,https://www.mizuki.com.sg

# --- Email ------------------------------------------------------------------
# Resend, with SPF and DKIM set up on mizuki.com.sg.
# Deliberately not Hostinger SMTP: shared-host mail is rate-limited and lands in spam,
# and a class reminder that quietly does not arrive is worse than no reminder at all.
RESEND_API_KEY=
MAIL_FROM=Mizuki Flora <hello@mizuki.com.sg>
MAIL_REPLY_TO=mizukisg148@gmail.com

# Where "someone just booked" alerts go.
ADMIN_ALERT_EMAIL=mizukisg148@gmail.com

# --- Instant alerts on the phone (optional) ---------------------------------
# Telegram: message @BotFather to create a bot, then @userinfobot for the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push for the admin console. Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mizukisg148@gmail.com

# --- Behaviour --------------------------------------------------------------
# Minutes a shop checkout holds a place before it goes back on sale.
HOLD_TTL_MINUTES=20
# How far ahead students can see and book.
CALENDAR_MONTHS_AHEAD=3
# Studio-local hour for the 2-day reminder and the morning digest.
REMINDER_SEND_HOUR=9
DIGEST_SEND_HOUR=7
