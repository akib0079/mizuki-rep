# Install devDependencies even when NODE_ENV=production.
#
# The build compiles TypeScript on the server, so tsc and vite have to be present at build
# time. npm treats NODE_ENV=production as "omit dev dependencies", which is right for a host
# that ships a prebuilt artefact and wrong for one that builds from source — the build fails
# with "tsc: command not found" while every dependency is correctly declared.
#
# Hostinger applies environment variables during the build, and NODE_ENV=production is needed
# at runtime for secure cookies, so this is set here rather than by dropping that variable.
include=dev

# Native modules (argon2) need their build scripts. Without this the password hashing library
# installs without its binary and the studio cannot sign in.
ignore-scripts=false
